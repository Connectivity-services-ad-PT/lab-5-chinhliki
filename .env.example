# API configuration
APP_HOST=0.0.0.0
APP_PORT=8000
AUTH_TOKEN=local-dev-token-real
SERVICE_NAME=core-business
SERVICE_VERSION=1.0.0
ENV=local

# Database configuration (used by compose db service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
POSTGRES_DB=core_business_db

# Database connection settings (used by core_app/main.py)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=mysecretpassword
DB_NAME=core_business_db

# External Services Integration (including AL - team-analytics, team-gate, team-notify)
ANALYTICS_SERVICE_URL=http://analytics_api:8000
GATE_SERVICE_URL=http://team-gate-api:8000
NOTIFY_SERVICE_URL=http://team-notify-api:8000